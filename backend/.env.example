PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:password@localhost:5432/luxewear"
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-secret"
# In production this must be 32+ characters; the server refuses to start otherwise.
# How long a login lasts in seconds (default 7 days) and the cookie SameSite mode (lax, strict or none)
TOKEN_TTL_SECONDS=604800
COOKIE_SAMESITE=lax
# Shared secret for payment webhooks (32+ characters in production)
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
